   <subjectdef keys="iirds.iirdsDomainEntity">
      <topicmeta>
         <navtitle>iiRDS domain entity</navtitle>
         <shortdesc>any resource within the iiRDS domain</shortdesc>
         <resourceid appid="http://iirds.tekom.de/iirds#iirdsDomainEntity"
                     appname="class-iri"/>
      </topicmeta>
      <subjectdef keys="iirds.AdministrativeMetadata">
         <topicmeta>
            <navtitle>administrative metadata</navtitle>
            <shortdesc>information that allows the management of iiRDS resources</shortdesc>
            <resourceid appid="http://iirds.tekom.de/iirds#AdministrativeMetadata"
                        appname="class-iri"/>
         </topicmeta>
         <subjectdef keys="iirds.ClassificationDomain">
            <topicmeta>
               <navtitle>external classification domain</navtitle>
               <shortdesc>domain of an external classification that is assigned to an iiRDS entity</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#ClassificationDomain"
                           appname="class-iri"/>
            </topicmeta>
         </subjectdef>
         <subjectdef keys="iirds.ClassificationType">
            <topicmeta>
               <navtitle>classification type</navtitle>
               <shortdesc>type of a classification that is assigned to an iiRDS domain entity</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#ClassificationType"
                           appname="class-iri"/>
            </topicmeta>
            <subjectdef keys="iirds.CDD">
               <topicmeta>
                  <navtitle>CDD identifier</navtitle>
                  <shortdesc>classification type that references a product classification in the Common Data Dictionary (CDD, IEC 61360)</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#CDD" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.DCC">
               <topicmeta>
                  <navtitle>DCC identifier</navtitle>
                  <shortdesc>classification type that references a product classification in the classification and designation of documents for plants, systems and equipment (DCC, IEC 61355)</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#DCC" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.EclassCodedName">
               <topicmeta>
                  <navtitle>ECLASS Coded Name</navtitle>
                  <shortdesc>8-digit class code that references an ECLASS product classification</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#EclassCodedName"
                              appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.EclassIRDI">
               <topicmeta>
                  <navtitle>ECLASS IRDI</navtitle>
                  <shortdesc>classification type that references an ECLASS product classification by an international registration data identifier (IRDI) path</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#EclassIRDI" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.VDI2770">
               <topicmeta>
                  <navtitle>VDI2770:2018 identifier</navtitle>
                  <shortdesc>classification type that references a document classification according to VDI2770:2018</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#VDI2770" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
         </subjectdef>
         <subjectdef keys="iirds.ContentLifeCycleStatus">
            <topicmeta>
               <navtitle>information unit life cycle status</navtitle>
               <shortdesc>stage of an information unit in the information development process</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#ContentLifeCycleStatus"
                           appname="class-iri"/>
            </topicmeta>
         </subjectdef>
         <subjectdef keys="iirds.ContentLifeCycleStatusValue">
            <topicmeta>
               <navtitle>value of the information unit life cycle status</navtitle>
               <shortdesc>categorical denomination of the information unit life cycle stage</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#ContentLifeCycleStatusValue"
                           appname="class-iri"/>
            </topicmeta>
            <subjectdef keys="iirds.Approved">
               <topicmeta>
                  <navtitle>approved</navtitle>
                  <shortdesc>content life cycle status value which indicates that the information of the resource is correct</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Approved" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.Deleted">
               <topicmeta>
                  <navtitle>deleted</navtitle>
                  <shortdesc>content life cycle status value which indicates that the information of the resource has been revoked</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Deleted" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.InPreparation">
               <topicmeta>
                  <navtitle>under preparation</navtitle>
                  <shortdesc>content life cycle status value which indicates that the information of the resource is still being edited</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#InPreparation"
                              appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.InReview">
               <topicmeta>
                  <navtitle>in review</navtitle>
                  <shortdesc>content life cycle status value which indicates that the information of the resource is being checked for correctness</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#InReview" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.Released">
               <topicmeta>
                  <navtitle>released</navtitle>
                  <shortdesc>content life cycle status value which indicates that the associated information of the resource has been approved and is ready for publishing</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Released" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.Reviewed">
               <topicmeta>
                  <navtitle>reviewed</navtitle>
                  <shortdesc>content life cycle status value which indicates that the information of the resource has been checked</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Reviewed" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.Withdrawn">
               <topicmeta>
                  <navtitle>withdrawn</navtitle>
                  <shortdesc>content life cycle status value which indicates that an already released information of the resource is not valid anymore</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Withdrawn" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
         </subjectdef>
         <subjectdef keys="iirds.ExternalClassification">
            <topicmeta>
               <navtitle>external classification</navtitle>
               <shortdesc>External classification of an iiRDS domain entity. Each classification must be related to the classification domain within which it is unambiguous.</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#ExternalClassification"
                           appname="class-iri"/>
            </topicmeta>
         </subjectdef>
         <subjectdef keys="iirds.Identity">
            <topicmeta>
               <navtitle>identity</navtitle>
               <shortdesc>complex identifier of a resource in an external system</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#Identity" appname="class-iri"/>
            </topicmeta>
         </subjectdef>
         <subjectdef keys="iirds.IdentityDomain">
            <topicmeta>
               <navtitle>identity domain</navtitle>
               <shortdesc>organizational origin of an identifier that is assigned to an iiRDS identity</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#IdentityDomain" appname="class-iri"/>
            </topicmeta>
         </subjectdef>
         <subjectdef keys="iirds.IdentityType">
            <topicmeta>
               <navtitle>identity type</navtitle>
               <shortdesc>distinguished set of identifiers that are assigned to an iiRDS identity</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#IdentityType" appname="class-iri"/>
            </topicmeta>
            <subjectdef keys="iirds.ArticleCode">
               <topicmeta>
                  <navtitle>article code</navtitle>
                  <shortdesc>identity type of the manufacturer's reference number or other identifier for products or for parts of a product</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#ArticleCode" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.EuropeanArticleNumber">
               <topicmeta>
                  <navtitle>EAN</navtitle>
                  <shortdesc>identity type of the European article number according to ISO/IEC 15420</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#EuropeanArticleNumber"
                              appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.GlobalTradeItemNumber">
               <topicmeta>
                  <navtitle>GTIN</navtitle>
                  <shortdesc>identity type of internationally coordinated, uniform, and globally unique article numbers for products and services</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#GlobalTradeItemNumber"
                              appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.ObjectInstanceURI">
               <topicmeta>
                  <navtitle>instance of object uri</navtitle>
                  <shortdesc>identity type of the globally unique URI for a product instance</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#ObjectInstanceURI"
                              appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.ObjectTypeURI">
               <topicmeta>
                  <navtitle>object URI  product type</navtitle>
                  <shortdesc>identity type of the globally unique URI of a product product type</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#ObjectTypeURI"
                              appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.OrderCode">
               <topicmeta>
                  <navtitle>order code</navtitle>
                  <shortdesc>identity type of the manufacturer's unique procurement key</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#OrderCode" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.ProductType">
               <topicmeta>
                  <navtitle>product type</navtitle>
                  <shortdesc>identity type for products of the same series</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#ProductType" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.SerialNumber">
               <topicmeta>
                  <navtitle>serial number</navtitle>
                  <shortdesc>identity type of the number used to identify an individual product instance</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#SerialNumber" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
         </subjectdef>
         <subjectdef keys="iirds.Party">
            <topicmeta>
               <navtitle>party</navtitle>
               <shortdesc>person, organization, or system</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#Party" appname="class-iri"/>
            </topicmeta>
         </subjectdef>
         <subjectdef keys="iirds.PartyRole">
            <topicmeta>
               <navtitle>party role</navtitle>
               <shortdesc>responsibility of a person or organization</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#PartyRole" appname="class-iri"/>
            </topicmeta>
            <subjectdef keys="iirds.Author">
               <topicmeta>
                  <navtitle>author</navtitle>
                  <shortdesc>party role of the party that edited the referenced information unit</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Author" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.Contributor">
               <topicmeta>
                  <navtitle>contributor</navtitle>
                  <shortdesc>party role of the party that provides input to the making of an information unit</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Contributor" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.Creator">
               <topicmeta>
                  <navtitle>creator</navtitle>
                  <shortdesc>party role of the party from which an information unit originated</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Creator" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
