            <navtitle>information type</navtitle>
            <shortdesc>characteristic of content</shortdesc>
            <resourceid appid="http://iirds.tekom.de/iirds#InformationType" appname="class-iri"/>
         </topicmeta>
         <subjectdef keys="iirds.DirectoryNodeType">
            <topicmeta>
               <navtitle>directory node type</navtitle>
               <shortdesc>type of information arranged in a hierarchically ordered list of elements built by a root node and its subordinate nodes</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#DirectoryNodeType"
                           appname="class-iri"/>
            </topicmeta>
            <subjectdef keys="iirds.Index">
               <topicmeta>
                  <navtitle>index</navtitle>
                  <shortdesc>directory node type that refers to an ordered arrangement of entries, designed to enable users to locate information in information units</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#Index" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.ListOfFigures">
               <topicmeta>
                  <navtitle>list of figures</navtitle>
                  <shortdesc>directory node type that refers to a list of visuals and their location within information units, generally in order of appearance</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#ListOfFigures"
                              appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.ListOfListings">
               <topicmeta>
                  <navtitle>list of listings</navtitle>
                  <shortdesc>directory node type that refers to a list of code snippets and their location within information units, generally in order of appearance</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#ListOfListings"
                              appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.ListOfTables">
               <topicmeta>
                  <navtitle>list of tables</navtitle>
                  <shortdesc>directory node type that refers to a list of tables and their location within information units, generally in order of appearance</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#ListOfTables" appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
            <subjectdef keys="iirds.TableOfContents">
               <topicmeta>
                  <navtitle>table of contents</navtitle>
                  <shortdesc>directory node type that refers to a list of information units in logical order</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#TableOfContents"
                              appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
         </subjectdef>
         <subjectdef keys="iirds.DocumentType">
            <topicmeta>
               <navtitle>document type</navtitle>
               <shortdesc>type of information arranged in a document defined with respect to its specified purpose, function, and form of presentation</shortdesc>
               <resourceid appid="http://iirds.tekom.de/iirds#DocumentType" appname="class-iri"/>
            </topicmeta>
            <subjectdef keys="iirds.AdministratorGuide">
               <topicmeta>
                  <navtitle>administrator guide</navtitle>
                  <shortdesc>document type that refers to information on the management of a technical system</shortdesc>
