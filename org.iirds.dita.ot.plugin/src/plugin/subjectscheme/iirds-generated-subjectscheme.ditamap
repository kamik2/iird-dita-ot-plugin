            <subjectdef keys="iirds.AssemblyInstructions">
               <topicmeta>
                  <navtitle>assembly instructions</navtitle>
                  <shortdesc>document type that refers to information on how parts are put together to complete a specific product so that it fulfils its intended use</shortdesc>
                  <resourceid appid="http://iirds.tekom.de/iirds#AssemblyInstructions"
                              appname="instance-iri"/>
               </topicmeta>
            </subjectdef>
