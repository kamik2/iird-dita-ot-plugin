<?xml version="1.0" encoding="UTF-8"?>
<assembly
	xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
    http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2
      http://maven.apache.org/xsd/assembly-1.1.2.xsd">
	<id>assembly</id>
	<formats>
		<format>zip</format>
	</formats>
	<includeBaseDirectory>true</includeBaseDirectory>
	<baseDirectory>org.iirds.dita.package</baseDirectory>
	<fileSets>
		<fileSet>
			<outputDirectory>/docs</outputDirectory>
			<directory>../docs</directory>
		</fileSet>
		<fileSet>
			<outputDirectory>/schemas</outputDirectory>
			<directory>src/main/resources</directory>
			<includes><include>*.rdf</include></includes>
		</fileSet>
		<fileSet>
			<outputDirectory>/</outputDirectory>
			<directory>src/plugin</directory>
			<excludes><exclude>iirds_plugin.pdf</exclude></excludes>
		</fileSet>
		<fileSet>
			<outputDirectory>/apidocs</outputDirectory>
			<directory>${project.build.directory}/site/apidocs</directory>
		</fileSet>
	</fileSets>
	<files>
		<file>
			<source>../README_TRANSFORMATIONS.md</source>
			<outputDirectory>/</outputDirectory>
		</file>
	</files>
	<dependencySets>
		<dependencySet>
			<outputDirectory>/lib</outputDirectory>
			<excludes>
				<exclude>org.slf4j:*</exclude>
				<exclude>net.sf.saxon:*</exclude>
				<exclude>xerces:*</exclude>
				<exclude>xml-apis:*</exclude>
				<exclude>xml-resolver:*</exclude>
				<exclude>dita-ot:dost:*</exclude>
				<exclude>*:pom</exclude>
				<exclude>*:zip</exclude>
			</excludes>
			<outputFileNameMapping>${artifact.artifactId}.${artifact.extension}</outputFileNameMapping>
			<useProjectArtifact>true</useProjectArtifact>
			<useTransitiveDependencies>true</useTransitiveDependencies>
			<scope>runtime</scope>
		</dependencySet>
	</dependencySets>
</assembly>
